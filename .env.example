# Copy to .env for local work. Never commit .env.

# Build-time read access (Supabase > Project Settings > API). Safe for the build;
# RLS only lets it read published articles.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=

# Only for scripts/push-guides.mjs on your own computer. Full write access:
# never put it in GitHub Actions, Cloudflare or any client code.
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare Pages deployment credentials
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=