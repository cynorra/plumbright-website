---
import { AUTHOR } from "../site.config.js";
interface Props { published?: Date; updated?: Date }
const { published, updated } = Astro.props;
const fmt = (d: Date) => d.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric", timeZone: "UTC" });
const initials = AUTHOR.name.split(" ").map((p) => p[0]).join("");
---
<aside class="mt-12 border border-line rounded-lg bg-surface p-5 flex gap-4 items-start max-w-[68ch]" aria-label="About the author">
  <div class="shrink-0 w-14 h-14 rounded-full bg-accent-soft text-accent grid place-items-center font-display font-bold text-lg" aria-hidden="true">{initials}</div>
  <div class="min-w-0">
    <p class="font-semibold">
      Written by <a href={`/author/${AUTHOR.slug}/`}>{AUTHOR.name}</a>
    </p>
    <p class="text-sm text-muted mt-1">{AUTHOR.shortBio}</p>
    {(published || updated) && (
      <p class="text-xs text-muted mt-2 num">
        {published && <>Published <time datetime={published.toISOString()}>{fmt(published)}</time></>}
        {updated && <> · Updated <time datetime={updated.toISOString()}>{fmt(updated)}</time></>}
      </p>
    )}
  </div>
</aside>
