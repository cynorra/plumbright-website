---
import { SITE } from "../site.config.js";
---
<div
  id="cookie-consent-banner"
  hidden
  class="fixed bottom-4 left-4 right-4 md:left-auto md:right-6 md:max-w-md z-50"
  role="dialog"
  aria-live="polite"
  aria-label="Cookie and Privacy Consent"
>
  <div class="rounded-2xl border border-border bg-card/95 backdrop-blur-md p-5 shadow-xl text-foreground">
    <div class="flex items-start gap-3">
      <div class="size-8 rounded-full bg-brand-soft text-brand flex items-center justify-center shrink-0 font-bold text-sm" aria-hidden="true">
        🍪
      </div>
      <div class="flex-1 text-xs">
        <h3 class="font-bold text-sm text-foreground mb-1">Privacy & Cookie Choices</h3>
        <p class="text-muted-foreground leading-relaxed">
          {SITE.name} uses Google AdSense to show ads, which can set cookies for personalized advertising. Ads and their cookies load only if you accept. Calculators and guides work either way. See the <a href="/privacy/#cookies" class="text-brand font-medium hover:underline">cookie section of the Privacy Policy</a>.
        </p>
        <div class="mt-4 flex flex-wrap items-center gap-2">
          <button
            id="cookie-consent-accept"
            type="button"
            class="px-4 py-2 rounded-lg bg-primary text-primary-foreground font-semibold text-xs hover:bg-primary/90 transition-colors shadow-xs cursor-pointer"
          >
            Accept
          </button>
          <button
            id="cookie-consent-reject"
            type="button"
            class="px-4 py-2 rounded-lg border border-border bg-card text-foreground font-semibold text-xs hover:bg-accent transition-colors cursor-pointer"
          >
            Reject
          </button>
          <a
            href="/privacy/#cookies"
            class="px-3 py-2 rounded-lg text-muted-foreground hover:text-foreground font-medium text-xs transition-colors no-underline hover:underline"
          >
            Manage Choices
          </a>
        </div>
      </div>
    </div>
  </div>
</div>

<script is:inline>
  // The banner is hidden in the HTML (no flash) and shown only when no choice is stored.
  // "materialguides_consent_accepted": "true" = accepted, "false" = rejected.
  (function () {
    var KEY = "materialguides_consent_accepted";
    var banner = document.getElementById("cookie-consent-banner");
    if (!banner) return;
    function stored() { try { return localStorage.getItem(KEY); } catch (e) { return null; } }
    function choose(value) {
      try { localStorage.setItem(KEY, value ? "true" : "false"); } catch (e) {}
      banner.hidden = true;
      window.dispatchEvent(new CustomEvent("materialguides:consent", { detail: value ? "accepted" : "rejected" }));
    }
    if (stored() === null) banner.hidden = false;
    document.getElementById("cookie-consent-accept").addEventListener("click", function () { choose(true); });
    document.getElementById("cookie-consent-reject").addEventListener("click", function () { choose(false); });
    // The "change your choice" button on the privacy page re-opens the banner.
    window.addEventListener("materialguides:reopen-consent", function () { banner.hidden = false; });
  })();
</script>
