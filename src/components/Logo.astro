---
// A plumb bob hanging from its line: the brand's literal namesake.
interface Props { size?: number }
const { size = 26 } = Astro.props;
---
<svg width={size} height={size} viewBox="0 0 32 32" aria-hidden="true" focusable="false">
  <line x1="16" y1="1" x2="16" y2="11" stroke="currentColor" stroke-width="2" />
  <path d="M10 12h12l-6 18z" fill="var(--brand)" />
  <rect x="10" y="11" width="12" height="3" rx="1" fill="currentColor" />
</svg>
