---
// Short, self-contained facts in plain sentences. Answer engines quote these
// directly, so each one must stand on its own without the rest of the page.
interface Props { facts: { label: string; value: string }[]; title?: string }
const { facts, title = "Key numbers" } = Astro.props;
---
<section aria-labelledby="key-facts" class="mx-auto mt-6 max-w-6xl px-4">
  <h2 id="key-facts" class="sr-only">{title}</h2>
  <dl class="bg-card grid overflow-hidden rounded-xl border sm:grid-cols-2 lg:grid-cols-4">
    {facts.map((f) => (
      <div class="border-border flex flex-col gap-1 border-b p-4 last:border-b-0 sm:[&:nth-last-child(-n+2)]:border-b-0 lg:border-r lg:border-b-0 lg:last:border-r-0">
        <dt class="text-muted-foreground text-xs font-medium">{f.label}</dt>
        <dd class="num text-foreground text-lg font-semibold">{f.value}</dd>
      </div>
    ))}
  </dl>
</section>
