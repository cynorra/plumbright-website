---
import Logo from "./Logo.astro";
import ThemeToggle from "./ThemeToggle.tsx";
import MobileNav from "./MobileNav.tsx";
import { SITE, NAV, FOOTER_LINKS } from "../site.config.js";
const path = Astro.url.pathname;
---
<header class="bg-background/80 supports-[backdrop-filter]:bg-background/70 sticky top-0 z-40 border-b backdrop-blur-md">
  <div class="mx-auto flex h-14 max-w-6xl items-center justify-between gap-4 px-4">
    <a href="/" class="text-foreground hover:text-foreground flex items-center gap-2 no-underline" aria-label={`${SITE.name} home`}>
      <Logo />
      <span class="font-display text-lg font-extrabold tracking-tight">{SITE.name}</span>
    </a>

    <div class="flex items-center gap-1">
      <nav aria-label="Main" class="hidden md:block">
        <ul class="flex items-center gap-0.5">
          {NAV.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={path.startsWith(item.href) ? "page" : undefined}
                class="text-muted-foreground hover:text-foreground hover:bg-accent aria-[current=page]:text-foreground rounded-md px-3 py-2 text-sm font-medium no-underline transition-colors aria-[current=page]:font-semibold"
              >{item.label}</a>
            </li>
          ))}
        </ul>
      </nav>
      <ThemeToggle client:idle />
      <MobileNav client:media="(max-width: 767px)" nav={NAV} secondary={FOOTER_LINKS} siteName={SITE.name} />
    </div>
  </div>
</header>
