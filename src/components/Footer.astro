---
import Logo from "./Logo.astro";
import { SITE, FOOTER_LINKS } from "../site.config.js";
import { TOOLS } from "../lib/tools.js";
const year = new Date().getFullYear();
---
<footer class="mt-20 border-t border-border bg-card">
  <div class="mx-auto max-w-6xl px-4 py-10 grid gap-8 md:grid-cols-[minmax(0,1fr)_minmax(0,1.4fr)_minmax(0,1fr)]">
    <div class="flex flex-col gap-2">
      <a href="/" class="flex items-center gap-2 no-underline text-foreground">
        <Logo size={22} />
        <span class="font-display font-extrabold">{SITE.name}</span>
      </a>
      <p class="text-sm text-muted-foreground max-w-xs">
        Calculators for home projects, with the formula, the assumptions and a worked example on every page.
      </p>
    </div>
    <nav aria-label="Calculators and guides">
      <h2 class="text-xs uppercase tracking-wider text-muted-foreground mb-3">Calculators</h2>
      <ul class="grid grid-cols-2 gap-1 text-sm">
        {TOOLS.map((t) => <li><a href={t.href}>{t.topic}</a></li>)}
        <li><a href="/calculators/">All calculators</a></li>
        <li><a href="/guides/">Guides</a></li>
      </ul>
    </nav>
    <nav aria-label="Site information">
      <h2 class="text-xs uppercase tracking-wider text-muted-foreground mb-3">About this site</h2>
      <ul class="grid grid-cols-2 gap-1 text-sm">
        {FOOTER_LINKS.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </nav>
  </div>
  <div class="border-t border-border">
    <p class="mx-auto max-w-6xl px-4 py-4 text-xs text-muted-foreground">
      © {year} {SITE.name}. Estimates are for planning. Check local building codes and product labels before you buy or build.
    </p>
  </div>
</footer>
