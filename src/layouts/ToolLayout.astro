---
import Base from "./Base.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import AuthorBox from "../components/AuthorBox.astro";
import { getCollection } from "astro:content";
import { breadcrumbSchema, calculatorSchema } from "../lib/schema.js";

interface Props {
  tool: "concrete" | "tile" | "paint";
  title: string;        // <title> and H1
  description: string;  // meta description
  lead: string;         // answer-first sentence under the H1
  published: Date;
  updated?: Date;
}

const { tool, title, description, lead, published, updated } = Astro.props;
const path = Astro.url.pathname;
const crumbs = [
  { name: "Home", path: "/" },
  { name: title, path },
];
const guides = (await getCollection("guides", (g) => !g.data.draft && g.data.tool === tool))
  .sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf());

const schema = [
  breadcrumbSchema(crumbs),
  calculatorSchema({
    name: title,
    description,
    path,
    updated: (updated ?? published).toISOString().slice(0, 10),
  }),
];
---
<Base title={title} description={description} schema={schema}>
  <div class="mx-auto max-w-6xl px-4 pt-6">
    <Breadcrumbs crumbs={crumbs} />
    <h1 class="mt-4 text-3xl md:text-4xl font-extrabold">{title}</h1>
    <p class="mt-3 text-lg text-muted max-w-[68ch]">{lead}</p>
    <div class="tick-rule mt-6 max-w-md"></div>
  </div>

  <section aria-label="Calculator" class="mx-auto max-w-6xl px-4 mt-6">
    <div class="rounded-xl border border-line bg-surface shadow-sm">
      <slot name="calculator" />
    </div>
  </section>

  <div class="mx-auto max-w-6xl px-4 mt-12 grid gap-12 lg:grid-cols-[minmax(0,1fr)_280px]">
    <article class="prose-site min-w-0">
      <slot />
    </article>

    <aside class="min-w-0 lg:sticky lg:top-6 self-start" aria-label="Related guides">
      {guides.length > 0 && (
        <div class="border border-line rounded-lg bg-surface p-5">
          <h2 class="font-display font-bold text-sm uppercase tracking-wider text-muted">Guides for this project</h2>
          <ul class="mt-3 grid gap-3">
            {guides.map((g) => (
              <li><a href={`/guides/${g.id}/`} class="font-medium leading-snug">{g.data.title}</a></li>
            ))}
          </ul>
        </div>
      )}
    </aside>
  </div>

  <div class="mx-auto max-w-6xl px-4">
    <AuthorBox published={published} updated={updated} />
  </div>
</Base>
