---
import Base from "./Base.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import AuthorBox from "../components/AuthorBox.astro";
import OnThisPage from "../components/OnThisPage.astro";
import KeyFacts from "../components/KeyFacts.astro";
import { getCollection } from "astro:content";
import { breadcrumbSchema, calculatorSchema, faqSchema } from "../lib/schema.js";
import { addHeadingIds, extractFaqItems } from "../lib/toc.js";
import { AUTHOR } from "../site.config.js";
import { getGuideCoverImage } from "../lib/guide-images.js";

interface Props {
  tool: string; // a key from src/lib/tools.js
  title: string;        // <title> and H1
  description: string;  // meta description
  lead: string;         // answer-first sentence under the H1
  facts: { label: string; value: string }[];
  sources?: { label: string; href: string }[];
  published: Date;
  updated?: Date;
}

const { tool, title, description, lead, facts, sources = [], published, updated } = Astro.props;
const path = Astro.url.pathname;
const crumbs = [{ name: "Home", path: "/" }, { name: title, path }];
const guides = (await getCollection("guides", (g) => !g.data.draft && g.data.tool === tool))
  .sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf());

const bodyHtml = await Astro.slots.render("default");
const { html, toc } = addHeadingIds(bodyHtml);
const fullToc = [...toc, ...(sources.length ? [{ id: "sources", text: "Sources" }] : [])];
const faqItems = extractFaqItems(html);
const faq = faqSchema(faqItems);

const lastDate = updated ?? published;
const fmtDate = (d: Date) => d.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric", timeZone: "UTC" });

const schema = [
  breadcrumbSchema(crumbs),
  calculatorSchema({ name: title, description, path, updated: lastDate.toISOString().slice(0, 10) }),
  ...(faq ? [faq] : []),
];
---
<Base title={title} description={description} schema={schema} published={published} updated={updated}>
  <div class="relative overflow-hidden border-b">
    <div class="plan-grid pointer-events-none absolute inset-0" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-6xl px-4 pt-6 pb-8">
      <Breadcrumbs crumbs={crumbs} />
      <h1 class="mt-5 text-4xl font-extrabold md:text-5xl">{title}</h1>
      <p class="text-muted-foreground mt-4 max-w-[62ch] text-lg">{lead}</p>
      <p class="text-muted-foreground mt-4 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm">
        <span>By <a href={`/author/${AUTHOR.slug}/`}>{AUTHOR.name}</a></span>
        <span aria-hidden="true">·</span>
        <span>Updated <time datetime={lastDate.toISOString()}>{fmtDate(lastDate)}</time></span>
        <span aria-hidden="true">·</span>
        <a href="/methodology/">Formula and sources</a>
      </p>
    </div>
  </div>

  <section aria-label="Calculator" class="mx-auto mt-8 max-w-6xl px-4">
    <div class="bg-card rounded-xl border shadow-sm">
      <slot name="calculator" />
    </div>
  </section>

  <KeyFacts facts={facts} />

  <div class="mx-auto mt-14 grid max-w-6xl gap-12 px-4 lg:grid-cols-[minmax(0,1fr)_260px]">
    <article class="prose-site min-w-0">
      <Fragment set:html={html} />
      {sources.length > 0 && (
        <>
          <h2 id="sources">Sources</h2>
          <ul>
            {sources.map((s) => <li><a href={s.href} rel={s.href.startsWith("http") ? "noopener" : undefined}>{s.label}</a></li>)}
          </ul>
        </>
      )}
      <AuthorBox published={published} updated={updated} />
    </article>

    <aside class="flex min-w-0 flex-col gap-8 self-start lg:sticky lg:top-20" aria-label="Page navigation and related guides">
      <OnThisPage items={fullToc} />
      {guides.length > 0 && (
        <div>
          <p class="text-muted-foreground mb-3 text-xs font-semibold tracking-wider uppercase">Guides for this project</p>
          <ul class="grid gap-3 text-sm">
            {guides.map((g) => (
              <li class="flex items-center gap-3">
                <a href={`/guides/${g.id}/`} class="relative block size-12 shrink-0 overflow-hidden rounded-lg border bg-slate-900">
                  <img
                    src={getGuideCoverImage(g.id, g.data.tool)}
                    alt=""
                    class="h-full w-full object-cover"
                    loading="lazy"
                  />
                </a>
                <a href={`/guides/${g.id}/`} class="font-medium leading-snug line-clamp-2 hover:text-brand transition-colors">
                  {g.data.title}
                </a>
              </li>
            ))}
          </ul>
        </div>
      )}
    </aside>
  </div>
</Base>
