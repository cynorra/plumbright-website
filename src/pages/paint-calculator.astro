---
import ToolLayout from "../layouts/ToolLayout.astro";
import { roomArea, paintEstimate, DOOR_SQFT, WINDOW_SQFT, DEFAULT_COVERAGE } from "../lib/calc/paint.js";
import { fmt } from "../lib/calc/util.js";

const buy = (p: { gallons: number; quarts: number }) =>
  [p.gallons ? `${p.gallons} gal` : "", p.quarts ? `${p.quarts} qt` : ""].filter(Boolean).join(" + ") || "–";

const rooms = [
  [10, 10, 8, "Small bedroom"],
  [12, 12, 8, "Bedroom"],
  [12, 14, 8, "Primary bedroom"],
  [14, 16, 9, "Living room"],
  [5, 8, 8, "Bathroom"],
  [10, 12, 8, "Home office"],
].map(([l, w, h, name]) => {
  const a = roomArea({ lengthFt: l as number, widthFt: w as number, heightFt: h as number, doors: 1, windows: 1 });
  const p = paintEstimate({ areaSqFt: a.walls, coats: 2 });
  return { name, size: `${l} × ${w} ft, ${h} ft walls`, walls: a.walls, gal: p.paintGallons, buy: buy(p.paintToBuy) };
});

const exA = roomArea({ lengthFt: 12, widthFt: 14, heightFt: 8, doors: 2, windows: 2, includeCeiling: false });
const exP = paintEstimate({ areaSqFt: exA.walls, coats: 2, coverageSqFtPerGal: 350 });
const leadA = roomArea({ lengthFt: 12, widthFt: 12, heightFt: 8, doors: 1, windows: 1 });
const leadP = paintEstimate({ areaSqFt: leadA.walls, coats: 2 });
---
<ToolLayout
  tool="paint"
  title="Paint Calculator"
  description="Estimate gallons of paint and primer for a room. Subtracts doors and windows, handles ceilings and multiple coats, and tells you how many gallons and quarts to buy."
  lead={`Enter the room size, openings and number of coats to see how much paint to buy. Two coats on the walls of a 12 × 12 ft bedroom with 8 ft ceilings, one door and one window, take about ${fmt(leadP.paintGallons, 1)} gallons.`}
  published={new Date("2026-10-13")}
>
  <div slot="calculator" id="paint-calc" class="grid md:grid-cols-[minmax(0,1fr)_minmax(0,22rem)]">
    <form class="p-5 md:p-6 flex flex-col gap-5" novalidate>
      <div class="grid gap-4 sm:grid-cols-3">
        <div class="field"><label for="p-len">Room length (ft)</label><input class="input" id="p-len" inputmode="decimal" value="12" /></div>
        <div class="field"><label for="p-wid">Room width (ft)</label><input class="input" id="p-wid" inputmode="decimal" value="12" /></div>
        <div class="field"><label for="p-hgt">Wall height (ft)</label><input class="input" id="p-hgt" inputmode="decimal" value="8" /></div>
      </div>
      <div class="grid gap-4 sm:grid-cols-3">
        <div class="field"><label for="p-doors">Doors</label><input class="input" id="p-doors" inputmode="numeric" value="1" /><span class="hint">{DOOR_SQFT} sq ft each</span></div>
        <div class="field"><label for="p-wins">Windows</label><input class="input" id="p-wins" inputmode="numeric" value="1" /><span class="hint">{WINDOW_SQFT} sq ft each</span></div>
        <div class="field"><label for="p-coats">Coats</label><input class="input" id="p-coats" inputmode="numeric" value="2" /></div>
      </div>
      <div class="grid gap-4 sm:grid-cols-3">
        <div class="field"><label for="p-cov">Coverage (sq ft/gal)</label><input class="input" id="p-cov" inputmode="decimal" value={DEFAULT_COVERAGE} /><span class="hint">Check your can's label</span></div>
      </div>
      <div class="flex flex-wrap gap-x-6 gap-y-2">
        <label class="flex items-center gap-2"><input type="checkbox" id="p-ceil" /> Include the ceiling</label>
        <label class="flex items-center gap-2"><input type="checkbox" id="p-primer" /> I need primer (1 coat)</label>
      </div>
      <p id="p-error" class="text-sm" style="color: var(--err)" role="alert"></p>
    </form>

    <div class="p-5 md:p-6 border-t md:border-t-0 md:border-l border-line bg-bg rounded-b-xl md:rounded-bl-none md:rounded-r-xl" aria-live="polite">
      <p class="text-xs uppercase tracking-wider text-muted font-semibold">Paint</p>
      <p class="mt-1"><span id="pr-gal" class="num text-4xl font-semibold text-accent">–</span> <span class="text-muted">gallons</span></p>
      <p class="text-sm">Buy: <strong id="pr-buy" class="num">–</strong></p>
      <div id="pr-primer-row" hidden class="mt-4">
        <p class="text-xs uppercase tracking-wider text-muted font-semibold">Primer</p>
        <p class="num"><span id="pr-pgal">–</span> gal · buy <strong id="pr-pbuy">–</strong></p>
      </div>
      <dl class="mt-4 grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-sm">
        <dt class="text-muted">Walls</dt><dd class="num"><span id="pr-walls">–</span> sq ft</dd>
        <dt class="text-muted">Openings</dt><dd class="num">− <span id="pr-open">–</span> sq ft</dd>
        <dt class="text-muted">Ceiling</dt><dd class="num"><span id="pr-ceil">0</span> sq ft</dd>
        <dt class="text-muted">To paint</dt><dd class="num"><span id="pr-total">–</span> sq ft</dd>
      </dl>
      <p class="mt-4 text-xs text-muted">Ceilings are usually a different paint. If you include the ceiling, buy it separately.</p>
    </div>
  </div>

  <h2>How to use the paint calculator</h2>
  <p>Measure the length and width of the room along the floor, and the wall height from floor to ceiling. Count the doors and windows. Choose the number of coats, then check the coverage on your paint can and enter it if it differs from {DEFAULT_COVERAGE} sq ft per gallon. The calculator shows the gallons you need and how to buy them in gallons and quarts.</p>

  <h2>How paint quantity is calculated</h2>
  <ul>
    <li><strong>Wall area</strong> = 2 × (length + width) × height</li>
    <li><strong>Openings</strong> = doors × {DOOR_SQFT} sq ft + windows × {WINDOW_SQFT} sq ft</li>
    <li><strong>Area to paint</strong> = wall area − openings (+ length × width if you include the ceiling)</li>
    <li><strong>Gallons</strong> = area to paint × coats ÷ coverage per gallon</li>
  </ul>
  <p>A standard interior door is 3 × 7 ft, which is where the {DOOR_SQFT} sq ft comes from. Windows vary more, so {WINDOW_SQFT} sq ft is an average for a 3 × 5 ft window. If you have a sliding door or a large picture window, measure it and treat it as two openings.</p>
  <p>When the result lands between whole gallons, the calculator adds quarts. Three or more quarts round up to another gallon, since that usually costs about the same.</p>

  <h2>Coverage: why the can says 250 to 400 sq ft</h2>
  <p>Paint makers print a range because the surface changes how far a gallon goes:</p>
  <div class="table-wrap">
    <table>
      <thead><tr><th>Surface</th><th>Expect per gallon</th></tr></thead>
      <tbody>
        <tr><td>Smooth, previously painted drywall</td><td class="num">350–400 sq ft</td></tr>
        <tr><td>New drywall, primed</td><td class="num">300–350 sq ft</td></tr>
        <tr><td>Light texture (orange peel)</td><td class="num">300–350 sq ft</td></tr>
        <tr><td>Heavy texture, popcorn ceiling</td><td class="num">200–300 sq ft</td></tr>
        <tr><td>Bare wood, masonry, brick</td><td class="num">150–250 sq ft</td></tr>
      </tbody>
      <caption>Typical ranges for planning. Use the spread rate on your paint's label or data sheet.</caption>
    </table>
  </div>

  <h2>Paint for common rooms</h2>
  <p>Walls only, two coats, one door and one window, {DEFAULT_COVERAGE} sq ft per gallon:</p>
  <div class="table-wrap">
    <table>
      <thead><tr><th>Room</th><th>Size</th><th>Wall area</th><th>Gallons</th><th>Buy</th></tr></thead>
      <tbody>
        {rooms.map((r) => (
          <tr><td>{r.name}</td><td class="num">{r.size}</td><td class="num">{fmt(r.walls)} sq ft</td><td class="num">{fmt(r.gal, 1)}</td><td class="num">{r.buy}</td></tr>
        ))}
      </tbody>
    </table>
  </div>

  <h2>Worked example: a 12 × 14 ft living room</h2>
  <p>8 ft walls, two doors, two windows, two coats, walls only:</p>
  <ol>
    <li>Wall area: 2 × (12 + 14) × 8 = <strong>{fmt(exA.grossWalls)} sq ft</strong>.</li>
    <li>Openings: 2 × {DOOR_SQFT} + 2 × {WINDOW_SQFT} = <strong>{fmt(exA.openings)} sq ft</strong>.</li>
    <li>Area to paint: {fmt(exA.grossWalls)} − {fmt(exA.openings)} = <strong>{fmt(exA.walls)} sq ft</strong>.</li>
    <li>Paint: {fmt(exA.walls)} × 2 ÷ 350 = <strong>{fmt(exP.paintGallons)} gallons</strong>.</li>
    <li>Buy <strong>{buy(exP.paintToBuy)}</strong>.</li>
  </ol>

  <h2>When you need primer</h2>
  <ul>
    <li>New drywall or fresh patches, which soak up paint unevenly.</li>
    <li>Going from a dark color to a much lighter one.</li>
    <li>Glossy surfaces, stains, water marks or smoke damage.</li>
    <li>Bare wood, especially knotty pine or cedar that can bleed through.</li>
  </ul>
  <p>Paint-and-primer-in-one products work well over sound, previously painted walls in a similar color. They do not replace a dedicated primer on the surfaces above.</p>

  <h2>Questions people ask</h2>
  <h3>How many gallons of paint for a 12 × 12 room?</h3>
  <p>About {fmt(leadP.paintGallons, 1)} gallons for two coats on the walls with 8 ft ceilings, one door and one window. Buy {buy(leadP.paintToBuy)}.</p>
  <h3>Is one coat enough?</h3>
  <p>Rarely. Two coats give even color and sheen, especially when changing colors. One coat can be enough when repainting the same color over a clean wall.</p>
  <h3>How much paint for trim?</h3>
  <p>Baseboards, door casings and window trim in an average room usually take less than a quart. Trim is normally a separate, glossier paint.</p>
</ToolLayout>

<script>
  import { roomArea, paintEstimate } from "../lib/calc/paint.js";
  import { num, fmt } from "../lib/calc/util.js";

  const root = document.getElementById("paint-calc")!;
  const $ = (id: string) => document.getElementById(id) as HTMLInputElement;
  const buy = (p: { gallons: number; quarts: number }) =>
    [p.gallons ? `${p.gallons} gal` : "", p.quarts ? `${p.quarts} qt` : ""].filter(Boolean).join(" + ") || "–";

  function update() {
    const err = document.getElementById("p-error")!;
    try {
      const a = roomArea({
        lengthFt: num($("p-len").value),
        widthFt: num($("p-wid").value),
        heightFt: num($("p-hgt").value),
        doors: num($("p-doors").value) || 0,
        windows: num($("p-wins").value) || 0,
        includeCeiling: $("p-ceil").checked,
      });
      const p = paintEstimate({
        areaSqFt: a.total,
        coats: num($("p-coats").value),
        coverageSqFtPerGal: num($("p-cov").value),
        primer: $("p-primer").checked,
      });
      document.getElementById("pr-gal")!.textContent = fmt(p.paintGallons, 1);
      document.getElementById("pr-buy")!.textContent = buy(p.paintToBuy);
      document.getElementById("pr-walls")!.textContent = fmt(a.grossWalls);
      document.getElementById("pr-open")!.textContent = fmt(a.openings);
      document.getElementById("pr-ceil")!.textContent = fmt(a.ceiling);
      document.getElementById("pr-total")!.textContent = fmt(a.total);
      document.getElementById("pr-primer-row")!.hidden = !$("p-primer").checked;
      document.getElementById("pr-pgal")!.textContent = fmt(p.primerGallons, 1);
      document.getElementById("pr-pbuy")!.textContent = buy(p.primerToBuy);
      err.textContent = "";
    } catch (e) {
      err.textContent = e instanceof Error ? e.message : "Check the values you entered.";
      ["pr-gal", "pr-buy", "pr-walls", "pr-open", "pr-total"].forEach((id) => (document.getElementById(id)!.textContent = "–"));
    }
  }

  root.addEventListener("input", update);
  root.addEventListener("change", update);
  root.querySelector("form")!.addEventListener("submit", (e) => e.preventDefault());
  update();
</script>
