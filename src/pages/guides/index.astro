---
import Base from "../../layouts/Base.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import { getCollection } from "astro:content";
import { breadcrumbSchema } from "../../lib/schema.js";
import { TOOLS } from "../../lib/tools.js";

const all = (await getCollection("guides", (g) => !g.data.draft))
  .sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf());
const groups = TOOLS
  .map((t) => ({ key: t.key, label: t.topic, href: t.href, name: t.name, items: all.filter((g) => g.data.tool === t.key) }))
  .filter((g) => g.items.length > 0);
const crumbs = [{ name: "Home", path: "/" }, { name: "Guides", path: "/guides/" }];
---
<Base
  title="Project Guides"
  description="Guides to measuring, estimating and buying materials for concrete, tile, flooring, drywall, decks, roofs and more, each with worked examples and tables."
  schema={[breadcrumbSchema(crumbs)]}
>
  <div class="mx-auto max-w-6xl px-4 pt-6">
    <Breadcrumbs crumbs={crumbs} />
    <h1 class="mt-4 text-3xl md:text-4xl font-extrabold">Project guides</h1>
    <p class="mt-3 text-lg text-muted-foreground max-w-[60ch]">How to measure, what to watch for and how much to buy, explained with worked examples.</p>
    <div class="tick-rule mt-6 max-w-md"></div>

    {groups.map((group) => (
      <section class="mt-10" aria-labelledby={`g-${group.key}`}>
        <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
          <h2 id={`g-${group.key}`} class="text-xl font-extrabold">{group.label}</h2>
          <a href={group.href} class="text-sm font-medium">{group.name} →</a>
        </div>
        <ul class="mt-4 grid gap-5 md:grid-cols-2">
          {group.items.map((g) => (
            <li class="border-t border-border pt-4">
              <a href={`/guides/${g.id}/`} class="font-display text-lg font-bold leading-snug">{g.data.title}</a>
              <p class="text-sm text-muted-foreground mt-1">{g.data.description}</p>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</Base>
