---
import Base from "../layouts/Base.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import { breadcrumbSchema } from "../lib/schema.js";
import { TOOL_GROUPS, TOOLS } from "../lib/tools.js";
import { SITE } from "../site.config.js";

const crumbs = [{ name: "Home", path: "/" }, { name: "Calculators", path: "/calculators/" }];
const itemList = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "Home project calculators",
  itemListElement: TOOLS.map((t, i) => ({ "@type": "ListItem", position: i + 1, name: t.name, url: new URL(t.href, SITE.url).href })),
};
---
<Base
  title="All Calculators"
  description="Every free material calculator on Material Guides: concrete, gravel, deck, roofing, stairs, tile, flooring, drywall, paint and square footage, each with its formula."
  schema={[breadcrumbSchema(crumbs), itemList]}
>
  <div class="relative overflow-hidden border-b">
    <div class="plan-grid pointer-events-none absolute inset-0" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-6xl px-4 pt-6 pb-10">
      <Breadcrumbs crumbs={crumbs} />
      <h1 class="mt-5 text-4xl font-extrabold md:text-5xl">All calculators</h1>
      <p class="text-muted-foreground mt-4 max-w-[60ch] text-lg">{TOOLS.length} free calculators for home projects. Each one shows its formula, a worked example and reference tables generated by the same code.</p>
    </div>
  </div>
  <div class="mx-auto max-w-6xl px-4">
    {TOOL_GROUPS.map((g) => (
      <section class="mt-12" aria-labelledby={`grp-${g.group.replace(/\W+/g, "-")}`}>
        <h2 id={`grp-${g.group.replace(/\W+/g, "-")}`} class="text-xl font-extrabold">{g.group}</h2>
        <ul class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {g.tools.map((t) => (
            <li>
              <a href={t.href} class="bg-card hover:border-brand group text-foreground flex h-full flex-col gap-2 rounded-xl border p-5 no-underline transition-colors">
                <span class="font-display group-hover:text-brand text-lg font-bold">{t.name}</span>
                <span class="text-muted-foreground text-sm">{t.blurb}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</Base>
