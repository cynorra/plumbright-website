---
import Base from "../layouts/Base.astro";
import { getCollection } from "astro:content";
import { slabVolume, concreteOrder } from "../lib/calc/concrete.js";
import { tileEstimate } from "../lib/calc/tile.js";
import { roomArea, paintEstimate } from "../lib/calc/paint.js";
import { fmt } from "../lib/calc/util.js";
import { SITE, AUTHOR } from "../site.config.js";

const c = concreteOrder(slabVolume({ lengthFt: 10, widthFt: 10, thicknessIn: 4 }), 10);
const t = tileEstimate({ areaSqFt: 100, tileWidthIn: 12, tileLengthIn: 12, groutIn: 0.125, wastePct: 10 });
const p = paintEstimate({ areaSqFt: roomArea({ lengthFt: 12, widthFt: 12, heightFt: 8, doors: 1, windows: 1 }).walls, coats: 2 });

const tools = [
  {
    href: "/concrete-calculator/",
    name: "Concrete",
    what: "Slabs, patios, round columns and fence post holes. Cubic yards and bag counts for 40, 50, 60 and 80 lb mix.",
    sample: `10 × 10 ft patio, 4 in thick: ${fmt(c.cubicYards)} yd³ · ${c.bags.find((b) => b.weight === 80).count} bags (80 lb)`,
  },
  {
    href: "/tile-calculator/",
    name: "Tile",
    what: "Floors and walls. Accounts for grout joint width and the extra waste of diagonal and herringbone layouts.",
    sample: `100 sq ft in 12 × 12 in tile: ${t.tiles} tiles with 10% waste`,
  },
  {
    href: "/paint-calculator/",
    name: "Paint",
    what: "Walls, ceilings and primer. Subtracts doors and windows and tells you how many gallons and quarts to buy.",
    sample: `12 × 12 ft bedroom, two coats: ${fmt(p.paintGallons, 1)} gal`,
  },
];

const guides = (await getCollection("guides", (g) => !g.data.draft))
  .sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf())
  .slice(0, 6);
---
<Base title={SITE.name} description={SITE.description}>
  <section class="mx-auto max-w-6xl px-4 pt-12 pb-4">
    <h1 class="text-4xl md:text-5xl font-extrabold max-w-3xl leading-[1.08]">Know how much to buy before you head to the store.</h1>
    <p class="mt-5 text-lg text-muted max-w-[60ch]">
      {SITE.name} has material calculators for concrete, tile and paint. Every calculator shows its formula, the assumptions behind it and a worked example, so you can check the math yourself instead of trusting a number you can't see.
    </p>
    <div class="tick-rule mt-8 max-w-md"></div>
  </section>

  <section aria-labelledby="tools-h" class="mx-auto max-w-6xl px-4 mt-8">
    <h2 id="tools-h" class="sr-only">Calculators</h2>
    <div class="grid gap-4 md:grid-cols-3">
      {tools.map((tool) => (
        <a href={tool.href} class="group flex flex-col gap-3 rounded-xl border border-line bg-surface p-6 no-underline text-ink hover:border-accent">
          <h3 class="font-display text-2xl font-extrabold">{tool.name} calculator</h3>
          <p class="text-muted text-[0.98rem]">{tool.what}</p>
          <p class="mt-auto pt-3 border-t border-line text-sm num text-ink">{tool.sample}</p>
          <span class="text-link font-semibold group-hover:text-accent">Open the calculator →</span>
        </a>
      ))}
    </div>
  </section>

  <section aria-labelledby="how-h" class="mx-auto max-w-6xl px-4 mt-16 grid gap-10 md:grid-cols-2">
    <div class="prose-site">
      <h2 id="how-h" class="!mt-0">How the numbers are made</h2>
      <p>Each calculator runs a short, published formula. The tables on each page are generated by the same code that runs the calculator, so the page and the tool always agree.</p>
      <p>Where a number depends on a product, such as how far a gallon of paint spreads or how much concrete a bag makes, we use the figures printed on common US products and tell you to check your own label. The <a href="/methodology/">methodology page</a> lists every formula and assumption.</p>
    </div>
    <div class="prose-site">
      <h2 class="!mt-0">Who is behind this site</h2>
      <p>{SITE.name} is written and built by <a href={`/author/${AUTHOR.slug}/`}>{AUTHOR.name}</a>, a computer engineer with a second major in industrial engineering. Corrections are welcome and get fixed quickly: use the <a href="/contact/">contact page</a>.</p>
    </div>
  </section>

  {guides.length > 0 && (
    <section aria-labelledby="guides-h" class="mx-auto max-w-6xl px-4 mt-16">
      <div class="flex items-baseline justify-between gap-4">
        <h2 id="guides-h" class="text-2xl font-extrabold">Latest guides</h2>
        <a href="/guides/" class="text-sm font-semibold">All guides →</a>
      </div>
      <ul class="mt-5 grid gap-4 md:grid-cols-2">
        {guides.map((g) => (
          <li class="border-t border-line pt-4">
            <a href={`/guides/${g.id}/`} class="font-display text-lg font-bold leading-snug">{g.data.title}</a>
            <p class="text-sm text-muted mt-1">{g.data.description}</p>
          </li>
        ))}
      </ul>
    </section>
  )}
</Base>
