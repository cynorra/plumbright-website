---
import Base from "../layouts/Base.astro";
import HomeCalculators from "../components/calculators/HomeCalculators.tsx";
import { getCollection } from "astro:content";
import { slabVolume, concreteOrder } from "../lib/calc/concrete.js";
import { fmt } from "../lib/calc/util.js";
import { SITE, AUTHOR } from "../site.config.js";
import { TOOL_BY_KEY, TOOL_GROUPS } from "../lib/tools.js";

const ex = concreteOrder(slabVolume({ lengthFt: 10, widthFt: 10, thicknessIn: 4 }), 10);
const bags80 = ex.bags.find((b) => b.weight === 80)!.count;

const guides = (await getCollection("guides", (g) => !g.data.draft))
  .sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf())
  .slice(0, 6);

const principles = [
  {
    title: "The formula is on the page",
    body: "Every calculator lists the math it runs, in plain arithmetic you can check with a phone calculator.",
  },
  {
    title: "The tables come from the code",
    body: "Reference tables are generated by the same tested code as the calculator, so the two never disagree.",
  },
  {
    title: "Product numbers are labeled",
    body: "Bag yields and paint coverage come from common US product labels, and you can change them to match yours.",
  },
];
---
<Base title={SITE.name} description={SITE.description}>
  <section class="relative overflow-hidden border-b">
    <div class="plan-grid pointer-events-none absolute inset-0" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-6xl px-4 pt-14 pb-12 md:pt-20">
      <p class="text-brand num text-sm font-medium">{TOOL_GROUPS.reduce((n, g) => n + g.tools.length, 0)} calculators · formula on every page</p>
      <h1 class="mt-3 max-w-3xl text-4xl leading-[1.05] font-extrabold md:text-6xl">
        Know how much to buy before you load the truck.
      </h1>
      <p class="text-muted-foreground mt-5 max-w-[56ch] text-lg">
        Free material calculators that show their work. Try one below: a 10 × 10 ft patio, 4 inches thick, takes {fmt(ex.cubicYards)} cubic yards of concrete, or {bags80} bags of 80 lb mix.
      </p>
      <div class="mt-10">
        <HomeCalculators client:load />
      </div>
    </div>
  </section>

  <section aria-labelledby="tools-h" class="mx-auto max-w-6xl px-4 pt-16">
    <div class="flex items-baseline justify-between gap-4">
      <h2 id="tools-h" class="text-3xl font-extrabold">Every calculator</h2>
      <a href="/calculators/" class="text-sm font-medium">All calculators →</a>
    </div>
    <div class="mt-8 grid gap-8 md:grid-cols-3">
      {TOOL_GROUPS.map((g) => (
        <div>
          <h3 class="text-muted-foreground text-xs font-semibold tracking-wider uppercase">{g.group}</h3>
          <ul class="mt-3 grid gap-1">
            {g.tools.map((t) => (
              <li>
                <a href={t.href} class="hover:bg-accent text-foreground group -mx-2 flex flex-col rounded-md px-2 py-2 no-underline transition-colors">
                  <span class="group-hover:text-brand font-semibold">{t.name}</span>
                  <span class="text-muted-foreground text-sm">{t.blurb}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <section aria-labelledby="how-h" class="mx-auto max-w-6xl px-4 py-16">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:items-start">
      <div>
        <h2 id="how-h" class="text-3xl font-extrabold">No number without its working</h2>
        <p class="text-muted-foreground mt-3 max-w-[48ch]">
          Most material calculators hand you a figure and nothing else. When it looks wrong, you can't tell whether the tool skipped the grout joint or forgot the door. Here, every step is visible.
        </p>
        <div class="tick-rule mt-6 max-w-xs"></div>
      </div>
      <ol class="grid gap-4 sm:grid-cols-3 lg:grid-cols-1">
        {principles.map((p, i) => (
          <li class="bg-card flex gap-4 rounded-xl border p-5">
            <span class="num text-brand text-sm font-semibold">{String(i + 1).padStart(2, "0")}</span>
            <div>
              <h3 class="text-base font-bold">{p.title}</h3>
              <p class="text-muted-foreground mt-1 text-[0.95rem]">{p.body}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>

    <figure class="bg-card mt-10 overflow-hidden rounded-xl border">
      <figcaption class="text-muted-foreground border-b px-5 py-3 text-xs font-semibold tracking-wider uppercase">
        What "show the work" looks like · 10 × 10 ft patio, 4 in thick
      </figcaption>
      <div class="num grid gap-x-8 gap-y-2 overflow-x-auto px-5 py-5 text-sm md:grid-cols-[auto_1fr] md:text-base">
        <span class="text-muted-foreground">Volume</span><span>10 ft × 10 ft × (4 in ÷ 12) = {fmt(ex.netCuFt)} cu ft</span>
        <span class="text-muted-foreground">+ 10% waste</span><span>{fmt(ex.netCuFt)} × 1.10 = {fmt(ex.totalCuFt)} cu ft</span>
        <span class="text-muted-foreground">Cubic yards</span><span>{fmt(ex.totalCuFt)} ÷ 27 = <strong class="text-brand">{fmt(ex.cubicYards)} yd³</strong></span>
        <span class="text-muted-foreground">80 lb bags</span><span>{fmt(ex.totalCuFt)} ÷ 0.60, rounded up = <strong class="text-brand">{bags80} bags</strong></span>
      </div>
    </figure>
  </section>

  {guides.length > 0 && (
    <section aria-labelledby="guides-h" class="border-t">
      <div class="mx-auto max-w-6xl px-4 py-16">
        <div class="flex items-baseline justify-between gap-4">
          <h2 id="guides-h" class="text-3xl font-extrabold">Guides</h2>
          <a href="/guides/" class="text-sm font-medium">All guides →</a>
        </div>
        <ul class="mt-8 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
          {guides.map((g) => (
            <li>
              <a href={`/guides/${g.id}/`} class="bg-card hover:border-brand group text-foreground flex h-full flex-col gap-3 rounded-xl border p-5 no-underline transition-colors">
                <span class="text-muted-foreground text-xs font-semibold tracking-wider uppercase">{TOOL_BY_KEY[g.data.tool].topic}</span>
                <span class="font-display group-hover:text-brand text-lg leading-snug font-bold">{g.data.title}</span>
                <span class="text-muted-foreground text-sm">{g.data.description}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <section aria-labelledby="who-h" class="border-t">
    <div class="mx-auto grid max-w-6xl gap-6 px-4 py-16 md:grid-cols-[auto_1fr] md:items-center">
      <div class="bg-brand-soft text-brand font-display grid size-16 place-items-center rounded-full text-xl font-bold" aria-hidden="true">
        {AUTHOR.name.split(" ").map((p) => p[0]).join("")}
      </div>
      <div>
        <h2 id="who-h" class="text-2xl font-extrabold">Who builds this</h2>
        <p class="text-muted-foreground mt-2 max-w-[62ch]">
          {SITE.name} is written and built by <a href={`/author/${AUTHOR.slug}/`}>{AUTHOR.name}</a>, a computer engineer with a second major in industrial engineering. It is independent, with no ties to any manufacturer or store. Found an error? <a href="/contact/">Tell us</a> and it gets fixed.
        </p>
      </div>
    </div>
  </section>
</Base>
