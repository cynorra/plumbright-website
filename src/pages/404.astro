---
import Base from "../layouts/Base.astro";
import { TOOLS } from "../lib/tools.js";
---
<Base title="Page not found" description="This page does not exist. Try one of the calculators or guides." noindex>
  <div class="mx-auto max-w-6xl px-4 py-16">
    <p class="num text-brand text-sm font-semibold">404</p>
    <h1 class="mt-2 text-3xl md:text-4xl font-extrabold">That page isn't here.</h1>
    <p class="mt-3 text-muted-foreground max-w-[55ch]">The link may be old or mistyped. These are the pages most people are looking for:</p>
    <ul class="mt-6 grid gap-2 sm:grid-cols-2 max-w-xl">
      {TOOLS.map((t) => <li><a href={t.href}>{t.name}</a></li>)}
      <li><a href="/guides/">All guides</a></li>
    </ul>
  </div>
</Base>
