---
import Base from "../layouts/Base.astro";
---
<Base title="Page not found" description="This page does not exist. Try one of the calculators or guides." noindex>
  <div class="mx-auto max-w-6xl px-4 py-16">
    <p class="num text-accent text-sm font-semibold">404</p>
    <h1 class="mt-2 text-3xl md:text-4xl font-extrabold">That page isn't here.</h1>
    <p class="mt-3 text-muted max-w-[55ch]">The link may be old or mistyped. These are the pages most people are looking for:</p>
    <ul class="mt-6 grid gap-2">
      <li><a href="/concrete-calculator/">Concrete calculator</a></li>
      <li><a href="/tile-calculator/">Tile calculator</a></li>
      <li><a href="/paint-calculator/">Paint calculator</a></li>
      <li><a href="/guides/">All guides</a></li>
    </ul>
  </div>
</Base>
