---
import { pageDates } from "../../page-dates.js";
import PageLayout from "../../layouts/PageLayout.astro";
import { getCollection } from "astro:content";
import { AUTHOR, SITE } from "../../site.config.js";

const guides = (await getCollection("guides", (g) => !g.data.draft))
  .sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf());

const person = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": `${SITE.url}/author/${AUTHOR.slug}/#person`,
  name: AUTHOR.name,
  url: `${SITE.url}/author/${AUTHOR.slug}/`,
  jobTitle: AUTHOR.role,
  sameAs: [AUTHOR.linkedin, AUTHOR.github],
  worksFor: { "@id": `${SITE.url}/#organization` },
};
---
<PageLayout
  title={AUTHOR.name}
  description={`${AUTHOR.name} builds the calculators on ${SITE.name} and writes its guides. Background, how he works and how to reach him.`}
  updated={pageDates("/author/eren-simsir/").updated ?? pageDates("/author/eren-simsir/").published}
  extraSchema={[person]}
>
  <div class="flex flex-col sm:flex-row items-center sm:items-start gap-6 mb-8 not-prose">
    <img
      src={AUTHOR.photo}
      alt={AUTHOR.name}
      width="160"
      height="160"
      class="w-36 h-36 rounded-full object-cover border-2 border-border shadow-md shrink-0"
    />
    <div>
      <p class="text-xl font-bold">{AUTHOR.name}</p>
      <p class="text-sm text-brand font-medium mt-1">{AUTHOR.role}</p>
      <p class="text-sm text-muted-foreground mt-3 max-w-xl">{AUTHOR.shortBio}</p>
    </div>
  </div>

  <p><strong>{AUTHOR.name}</strong> is the founder, editor, and lead developer of {SITE.name}. He holds a B.Sc. in Computer Engineering from Düzce University, is currently pursuing his Master's (M.Sc.) in Computer Engineering at Kocaeli University, and is completing a double major in Industrial Engineering.</p>

  <h2>Education & Credentials</h2>
  <ul>
    <li><strong>M.Sc. in Computer Engineering</strong> — Kocaeli University (Ongoing)</li>
    <li><strong>B.Sc. in Computer Engineering</strong> — Düzce University (2025)</li>
    <li><strong>Double Major in Industrial Engineering</strong> — Specializing in mathematical modeling, estimation, quality standards, and optimization</li>
    <li>Professional software engineer experienced in building algorithmic web systems and data-driven tools</li>
  </ul>

  <h2>Editorial Standards & Methodology</h2>
  <p>Eren combines software engineering precision with industrial engineering principles to eliminate guesswork in home improvement calculations. Rather than treating formulas as black boxes, every calculator on {SITE.name} exposes its underlying math, source standards, and material tolerances.</p>
  <p>All calculators undergo unit testing against manufacturer specifications, code tables, and real-world worked examples. Where structural engineering, permit requirements, or local municipal building codes dictate licensed professional evaluation, our guides explicitly state these boundaries.</p>
  <p>For more details on calculation standards and verification, read our <a href="/methodology/">methodology page</a> and our <a href="/editorial-policy/">editorial policy</a>.</p>

  <h2>Connect with Eren</h2>
  <p>Have feedback, found a discrepancy, or need a specific formula added? Reach out directly via <a href={`mailto:${SITE.email}`}>{SITE.email}</a> or visit the <a href="/contact/">contact page</a>.</p>
  <p>Professional profiles: <a href={AUTHOR.linkedin} rel="me noopener" target="_blank">LinkedIn Profile</a> · <a href={AUTHOR.github} rel="me noopener" target="_blank">GitHub Profile</a></p>

  {guides.length > 0 && (
    <div class="not-prose mt-12 pt-8 border-t">
      <div class="flex items-center justify-between mb-6">
        <div>
          <h2 class="text-2xl font-extrabold text-foreground">Guides & Field Reports by {AUTHOR.name}</h2>
          <p class="text-sm text-muted-foreground mt-1">Written with open formulas, verified building codes, and manufacturer yield data.</p>
        </div>
        <span class="text-xs font-mono text-brand border border-brand/30 bg-brand-soft/20 px-2.5 py-1 rounded-full font-bold">
          {guides.length} Articles
        </span>
      </div>

      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {guides.map((g) => (
          <article class="bg-card hover:border-brand/60 group text-foreground flex h-full flex-col justify-between rounded-xl border overflow-hidden transition-all shadow-xs hover:shadow-md">
            <a href={`/guides/${g.id}/`} class="relative block aspect-video overflow-hidden bg-slate-900 border-b">
              <img
                src={`/images/guides/${g.data.tool}.svg`}
                alt={g.data.title}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                loading="lazy"
              />
              <div class="absolute bottom-2 right-2 bg-black/75 backdrop-blur-xs text-white text-[10px] font-mono px-2 py-0.5 rounded">
                {Math.max(3, Math.ceil((g.body || "").trim().split(/\s+/).length / 200))} min
              </div>
            </a>
            <div class="p-4 flex flex-col justify-between flex-1">
              <div>
                <time datetime={g.data.published.toISOString()} class="text-[11px] text-muted-foreground block mb-1.5 font-mono">
                  {g.data.published.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric", timeZone: "UTC" })}
                </time>
                <h3 class="font-display group-hover:text-brand text-base font-bold leading-snug">
                  <a href={`/guides/${g.id}/`} class="text-foreground group-hover:text-brand no-underline">
                    {g.data.title}
                  </a>
                </h3>
              </div>
              <div class="mt-4 pt-3 border-t flex items-center justify-between text-xs text-muted-foreground">
                <span class="capitalize">{g.data.tool}</span>
                <a href={`/guides/${g.id}/`} class="text-brand font-semibold group-hover:translate-x-1 transition-transform inline-flex items-center gap-1">
                  Read guide <span>→</span>
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  )}
</PageLayout>
