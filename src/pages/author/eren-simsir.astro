---
import { pageDates } from "../../page-dates.js";
import PageLayout from "../../layouts/PageLayout.astro";
import { getCollection } from "astro:content";
import { AUTHOR, SITE } from "../../site.config.js";

const guides = (await getCollection("guides", (g) => !g.data.draft))
  .sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf());

const person = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": `${SITE.url}/author/${AUTHOR.slug}/#person`,
  name: AUTHOR.name,
  url: `${SITE.url}/author/${AUTHOR.slug}/`,
  jobTitle: AUTHOR.role,
  sameAs: [AUTHOR.linkedin, AUTHOR.github],
  worksFor: { "@id": `${SITE.url}/#organization` },
};
---
<PageLayout
  title={AUTHOR.name}
  description={`${AUTHOR.name} builds the calculators on ${SITE.name} and writes its guides. Background, how he works and how to reach him.`}
  updated={pageDates("/author/eren-simsir/").updated ?? pageDates("/author/eren-simsir/").published}
  extraSchema={[person]}
>
  <p><strong>{AUTHOR.name}</strong> is the founder and editor of {SITE.name}. He builds every calculator on the site and writes the guides that explain them.</p>

  <h2>Background</h2>
  <!-- TODO: review every line below and keep only what you are comfortable publishing. -->
  <ul>
    <li>B.Sc. in Computer Engineering, Düzce University (2025)</li>
    <li>M.Sc. student in Computer Engineering, Kocaeli University</li>
    <li>Second major in Industrial Engineering, a field built on measurement, estimation and planning</li>
    <li>Works as a software developer; previously worked as a data scientist</li>
  </ul>

  <h2>What that means for this site</h2>
  <p>Eren is an engineer, not a contractor or licensed tradesperson. His job here is the math: turning the rules builders use into calculators that show their work, testing the code, and checking every constant against manufacturer data and building codes. Where a question needs a professional on site, such as footing design or structural changes, the guides say so.</p>
  <p>Every calculator is covered by automated tests, and the tables in the guides are generated by the same code. See the <a href="/methodology/">methodology page</a> for the formulas and sources, and the <a href="/editorial-policy/">editorial policy</a> for how pages are written and updated.</p>

  <h2>Contact</h2>
  <p>Found an error or have a project the calculators do not cover? Email <a href={`mailto:${SITE.email}`}>{SITE.email}</a> or use the <a href="/contact/">contact page</a>.</p>
  <p>Elsewhere: <a href={AUTHOR.linkedin} rel="me noopener" target="_blank">LinkedIn</a> · <a href={AUTHOR.github} rel="me noopener" target="_blank">GitHub</a></p>

  {guides.length > 0 && (
    <>
      <h2>Guides by {AUTHOR.name}</h2>
      <ul>
        {guides.map((g) => <li><a href={`/guides/${g.id}/`}>{g.data.title}</a></li>)}
      </ul>
    </>
  )}
</PageLayout>
